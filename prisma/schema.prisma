generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model funcionarios {
  id      Int    @id @default(autoincrement())
  nome    String @db.VarChar(255)
  empresa String @db.VarChar(255)
  setor   String @db.VarChar(255)
}

model presenca {
  id          Int      @id @default(autoincrement())
  empresa     String   @db.VarChar(255)
  setor       String   @db.VarChar(255)
  funcionario String   @db.VarChar(255)
  data_hora   DateTime @default(now()) @db.Date
}

// model users removed

model usuario_empresas {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  empresa    String   @db.VarChar(255)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model usuarios {
  id               Int                @id @default(autoincrement())
  username         String             @unique @db.VarChar(50)
  email            String?            @unique @db.VarChar(255)
  password_hash    String?            @db.VarChar(255)
  role             Role?
  can_register     Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  usuario_empresas usuario_empresas[]
}

model empresas {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
}

enum Role {
  admin
  educador
  suporte
  pendente
}
