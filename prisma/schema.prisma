generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model funcionarios {
  id      Int    @id @default(autoincrement())
  nome    String @db.VarChar(255)
  empresa String @db.VarChar(255)
  setor   String @db.VarChar(255)
}

model presenca {
  id          Int      @id @default(autoincrement())
  empresa     String   @db.VarChar(255)
  setor       String   @db.VarChar(255)
  funcionario String   @db.VarChar(255)
  data_hora   DateTime @default(now()) @db.Date
}

model users {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  role         String    @db.VarChar(50)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
}

model usuario_empresas {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  empresa    String   @db.VarChar(255)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model usuarios {
  id               Int                @id @default(autoincrement())
  username         String             @unique @db.VarChar(50)
  password_hash    String             @db.VarChar(255)
  role             Role
  can_register     Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  usuario_empresas usuario_empresas[]
}

enum Role {
  admin
  educador
  suporte
}
