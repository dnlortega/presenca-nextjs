generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model funcionarios {
  id         Int        @id @default(autoincrement())
  nome       String     @db.VarChar(255)
  valor      Decimal?   @db.Decimal(10, 2)
  empresa_id Int
  setor_id   Int
  empresa    empresas   @relation(fields: [empresa_id], references: [id])
  setor      setores    @relation(fields: [setor_id], references: [id])
  presencas  presenca[]

  @@index([empresa_id, setor_id])
  @@index([empresa_id, nome])
  @@index([empresa_id])
  @@index([setor_id])
}

model presenca {
  id             Int          @id @default(autoincrement())
  funcionario_id Int
  funcionario    funcionarios @relation(fields: [funcionario_id], references: [id], onDelete: Cascade)
  data_hora      DateTime     @default(now()) @db.Date

  @@index([funcionario_id, data_hora])
  @@index([funcionario_id])
  @@index([data_hora])
}

model setores {
  id           Int            @id @default(autoincrement())
  nome         String         @db.VarChar(255)
  empresa_id   Int
  empresa      empresas       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  status       String?        @default("ativo")
  funcionarios funcionarios[]

  @@unique([empresa_id, nome])
  @@index([empresa_id, nome])
  @@index([empresa_id])
}

model usuario_empresas {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  empresa_id Int
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  empresa    empresas @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([empresa_id])
}

model usuarios {
  id               Int                @id @default(autoincrement())
  username         String             @unique @db.VarChar(50)
  email            String?            @unique @db.VarChar(255)
  password_hash    String?            @db.VarChar(255)
  role             Role?
  can_register     Boolean            @default(false)
  can_edit         Boolean            @default(false)
  force_logout     Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  usuario_empresas usuario_empresas[]
}

model empresas {
  id               Int                @id @default(autoincrement())
  nome             String             @unique @db.VarChar(255)
  setores          setores[]
  funcionarios     funcionarios[]
  usuario_empresas usuario_empresas[]
}

model audit_log {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entity_id  Int?
  details    String?  @db.Text
  created_at DateTime @default(now())

  @@index([usuario_id])
  @@index([action])
  @@index([created_at])
}

enum Role {
  admin
  educador
  suporte
  pendente
}

model configuracoes {
  chave String @id @db.VarChar(100)
  valor String @db.Text
}
